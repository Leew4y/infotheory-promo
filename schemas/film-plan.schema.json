{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "film": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "fps": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "bpm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "styles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "chapters": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "voice": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "scenes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "page",
              "plate",
              "demo"
            ]
          },
          "chapter": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "dur": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minDur": {
            "type": "number",
            "minimum": 0
          },
          "lead": {
            "type": "number",
            "minimum": 0
          },
          "gap": {
            "type": "number",
            "minimum": 0
          },
          "tail": {
            "type": "number",
            "minimum": 0
          },
          "lines": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "text": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                },
                "read": {
                  "type": "string"
                },
                "pause": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "captions": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "items": false,
              "minItems": 4,
              "maxItems": 4
            }
          },
          "copy": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "capture": {
            "type": "object",
            "properties": {
              "asset": {
                "type": "string",
                "pattern": "^[^/\\\\:\\u0000]+(?:\\/[^/\\\\:\\u0000]+)*$"
              },
              "edit": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "number",
                      "minimum": 0
                    },
                    "to": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "speed": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "from",
                    "to"
                  ],
                  "additionalProperties": false
                }
              },
              "camera": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "t": {
                      "type": "number",
                      "minimum": 0
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "zoom": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "t",
                    "x",
                    "y",
                    "zoom"
                  ],
                  "additionalProperties": false
                }
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "asset"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "film",
    "fps",
    "styles",
    "scenes"
  ],
  "additionalProperties": false
}
