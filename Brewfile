# macOS tools for this repository: brew bundle (or just mac-setup). Versions verified on an M5 Pro, 2026-10-23:
# bun 1.4.4, just 1.59.0, ffmpeg 9.0.2, uv 0.13.1, speech 0.0.28.
brew "bun"
brew "just"
brew "ffmpeg"
brew "uv"
# narration (CosyVoice3 in MLX), voice design checks and transcription; Apple silicon only
brew "speech"
